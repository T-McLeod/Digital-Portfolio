# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (SQLite)
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3

# Database Settings (PostgreSQL) - Uncomment when switching to PostgreSQL
# DB_ENGINE=postgresql
# DB_NAME=portfolio_db
# DB_USER=portfolio_user
# DB_PASSWORD=your_secure_password
# DB_HOST=db
# DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# CSRF Settings
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Media and Static Files
MEDIA_URL=/media/
STATIC_URL=/static/

# Security Settings (Production)
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
